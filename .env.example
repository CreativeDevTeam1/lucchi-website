# Copy to .env.local (git-ignored) and fill in. NAMES only: never commit a real value.

# Sanity project (optional: the defaults are the Lucchi project and the production dataset)
SANITY_PROJECT_ID=
SANITY_DATASET=

# Viewer token: needed by the build-time sync (npm run sync / npm run build). Also set it in the Vercel project.
SANITY_READ_TOKEN=

# Editor token: only for the one-off Sanity scripts in scripts/ (import / patch / sync-folders). Local only.
SANITY_WRITE_TOKEN=

# Optional: output folder for scripts/generate-hero.mjs
HERO_OUT_DIR=
